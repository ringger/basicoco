# Coverage for `python -m pytest -m "" --cov`.
# patch = subprocess also measures the server (live_server fixture) and the
# CLI / basicoco.py sessions the integration tests start as subprocesses.
[run]
source =
    emulator
    app
    cli_client
    basicoco
patch = subprocess
# live_server stops the server with SIGTERM; save its data on the way out
sigterm = true
branch = false

[report]
skip_empty = true
show_missing = true
exclude_also =
    if __name__ == .__main__.:
    raise NotImplementedError
